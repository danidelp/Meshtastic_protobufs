# options for nanopb para el módulo MonitorAssist
# https://jpa.kapsi.fi/nanopb/docs/reference.html#proto-file-options

*MonitorAssistTelemetry.timestamp       int_size:32
*MonitorAssistTelemetry.heart_rate      int_size:8
*MonitorAssistTelemetry.altitude        int_size:16
*MonitorAssistTelemetry.assist_flags    int_size:8
*MonitorAssistTelemetry.battery_level   int_size:8

# Variables sfixed32, ya se les asigna por defecto 32 bits sin tener que indicarlo 
# *MonitorAssistTelemetry.latitude_i      int_size:32
# *MonitorAssistTelemetry.longitude_i     int_size:32